DATABASE_URL=
# Comma-separated emails granted administrator access on sign-up/sign-in while no active administrator exists.
# Create these accounts before sharing the site publicly; accounts do not yet verify email ownership.
ADMIN_EMAILS=
# Optional temporary password (12+ characters) for the ADMIN_EMAILS accounts, applied during production builds
# (or `npm run db:bootstrap-admins`): creates the first administrator accounts, or resets an administrator's password.
# Each value is applied once; change it and redeploy to issue a new one. Remove it after the administrator signs in.
ADMIN_TEMP_PASSWORD=
