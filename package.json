{
  "name": "civic-hands",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ] && [ -n \"$DATABASE_URL\" ]; then npm run db:migrate:deploy && npm run db:bootstrap-admins:deploy; fi && npm run build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:migrate": "dotenv -e .env.local -- node scripts/migrate.mjs",
    "db:migrate:deploy": "node scripts/migrate.mjs",
    "db:migrate:baseline": "dotenv -e .env.local -- node scripts/migrate.mjs --baseline",
    "db:bootstrap-admins": "dotenv -e .env.local -- node scripts/bootstrap-admins.mjs",
    "db:bootstrap-admins:deploy": "node scripts/bootstrap-admins.mjs",
    "user:set-password": "dotenv -e .env.local -- node scripts/set-password.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.49.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.3",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
